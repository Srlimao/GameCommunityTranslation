# ==============================================================================
# Local Game Translator - Environment Configuration
# ==============================================================================

# Server Hosting
PORT=3001
HOST=0.0.0.0

# SQLite Database Location
SQLITE_DB_PATH=./data/translator.db

# ------------------------------------------------------------------------------
# 1. Translation Engine Defaults
# Provider options: openai_compatible | gemini | anthropic
# ------------------------------------------------------------------------------
TRANSLATION_PROVIDER=openai_compatible
TRANSLATION_MODEL=translategemma-12b-it
TRANSLATION_BASE_URL=http://localhost:1234/v1
TRANSLATION_API_KEY=
TRANSLATION_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# 2. QA & Glossary Inspector Defaults
# Provider options: gemini | openai_compatible | anthropic
# ------------------------------------------------------------------------------
QA_PROVIDER=gemini
QA_MODEL=gemini-2.5-flash
QA_BASE_URL=
QA_API_KEY=

# ------------------------------------------------------------------------------
# 3. Performance & Tuning
# ------------------------------------------------------------------------------
BATCH_CONCURRENCY=1
REQUEST_TIMEOUT_MS=60000

# Legacy compatibility env vars
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=translategemma-12b-it
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
